missing_separator: Err(MissingSeparator { line: 1 })
empty_key: Err(EmptyKey { line: 1 })
invalid_caps: Err(InvalidCaps { key: CapsMapKey("func"), caps: "XYZ", line: 1, source: InvalidLetter { letter: 'X' } })
duplicate_caps: Err(InvalidCaps { key: CapsMapKey("func"), caps: "BB", line: 1, source: DuplicateLetter { letter: 'B' } })
duplicate_key: Err(DuplicateKey { key: CapsMapKey("func"), first_line: 1, line: 3 })
