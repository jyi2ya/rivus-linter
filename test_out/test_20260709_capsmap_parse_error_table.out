missing_header: Err(MissingV2Header { expected: "# rivus-caps-v2" })
empty_key: Err(EmptyKey { line: 2 })
invalid_caps: Err(InvalidV2Record { line: 2, source: Error("invalid capability letter: 'X'", line: 1, column: 27) })
